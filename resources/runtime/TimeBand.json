{
    "name": "Timeband",
    "kind": "component",
    "description": "Time band around a date. Config keys are date, cb_moved, and cb_moving.",
    "extends": [
        "Uxi",
        "Touch",
        "Placeholder"
    ],
    "oml": "oml://examples#Timeband",
    "access": "Registered with require('Timeband', 'Uxi', 'Touch', 'Placeholder'). OML addresses it as selector:Timeband. Call the methods on the instance. Method names are not OML keys.",
    "properties": [
        {
            "name": "date",
            "type": "any",
            "access": "readwrite",
            "in_oml": true,
            "description": "Constructor config field. When this object is created from OML, this name is a config key, not a method."
        },
        {
            "name": "cb_moved",
            "type": "any",
            "access": "readwrite",
            "in_oml": true,
            "description": "Constructor config field. When this object is created from OML, this name is a config key, not a method."
        },
        {
            "name": "cb_moving",
            "type": "any",
            "access": "readwrite",
            "in_oml": true,
            "description": "Constructor config field. When this object is created from OML, this name is a config key, not a method."
        }
    ],
    "methods": [
        {
