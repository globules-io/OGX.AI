                {
                    "name": "data",
                    "type": "any",
                    "required": true
                },
                {
                    "name": "route_data",
                    "type": "any",
                    "required": true
                }
            ],
            "returns": "void",
            "example": "instance.construct(data, route_data)"
        },
        {
            "name": "resize",
            "description": "Overrides a base method. issue, when I resize, the months change length, they should not",
            "params": [],
            "returns": "void",
            "example": "instance.resize()"
        },
        {
            "name": "onMove",
            "description": "hard callbacks, overridable",
            "params": [],
            "returns": "void",
            "example": "instance.onMove()"
        },
        {
            "name": "onMoved",
            "description": "Method on this instance.",
            "params": [],
            "returns": "void",
            "example": "instance.onMoved()"
        },
        {
            "name": "onRender",
            "description": "Method on this instance.",
            "params": [],
            "returns": "void",
            "example": "instance.onRender()"
        },
        {
            "name": "pxPerDay",
            "description": "Method on this instance.",
            "params": [],
            "returns": "any",
            "example": "instance.pxPerDay()"
        },
        {
            "name": "date",
            "description": "should use moveToDate instead after I render date ?",
            "params": [
                {
                    "name": "date",
                    "type": "any",
                    "required": true
                }
            ],
            "returns": "any",
